Options -Indexes
RewriteEngine On

# The public endpoint is behind a TLS-terminating reverse proxy. Apache sees
# that internal hop as HTTP, so also honor the original request scheme.
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !^https$ [NC]
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=308,L]

# OAuth discovery deliberately uses dot paths. Route these two public metadata
# documents before the generic hidden-file protection is evaluated.
RewriteRule ^\.well-known/(oauth-protected-resource(?:/mcp)?|oauth-authorization-server)$ index.php [END,QSA]

# All other dot paths remain inaccessible.
RewriteRule (^|/)\. - [F,L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^ index.php [END,QSA]

<FilesMatch "\.(?:ini|log|sql|json|md)$">
    Require all denied
</FilesMatch>
