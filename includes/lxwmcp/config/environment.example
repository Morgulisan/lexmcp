# Produktionsmodus erzwingt HTTPS für Lexware und Pflichtschlüssel.
LEXMCP_ENV=production
LEXMCP_PUBLIC_URL=https://lxwmcp.mopoliti.de

# Bestehende Datei; nicht in dieses Projekt kopieren.
LEXMCP_DATABASE_INCLUDE=/includes/api/sql.php
LEXMCP_FILE_TRANSFER_INCLUDE=/includes/libs/FileTransfer/Storage.php

# Optional. Ohne Umgebungsvariable wird der jeweilige Schlüssel einmalig im
# privaten LEXMCP_DATA_PATH erzeugt und dauerhaft gespeichert.
LEXMCP_ENCRYPTION_KEY=
LEXMCP_FINGERPRINT_KEY=

LEXMCP_DATA_PATH=/data/lxwmcp
LEXMCP_LEXWARE_BASE_URL=https://api.lexware.io
# Neueste MCP-Variante plus klassische Streamable-HTTP-Versionen. Diese breite
# Auswahl vermeidet Verbindungsabbrueche bei Clients mit abweichendem Release.
LEXMCP_PROTOCOL_VERSIONS=2026-07-28,2025-11-25,2025-06-18,2025-03-26,2024-11-05
LEXMCP_ALLOWED_ORIGINS=https://lxwmcp.mopoliti.de

# Kommagetrennte HTTPS-Hosts; explizit leer deaktiviert URL-Uploads.
# Ohne Variable gilt diese Standardliste. Eigene Listen ersetzen den Standard.
# *.domain erlaubt Subdomains, nicht die Hauptdomain; *crm erlaubt auch Präfixe vor crm.
LEXMCP_REMOTE_FILE_HOSTS=drive.google.com,*.mopoliti.de,*.sldo.de,*.tecis.de,*crm.vertrieb-plattform.de

# Finalisieren wird pro Benutzer unter /accounts gesteuert (Standard: an).
# LEXMCP_ENABLE_FINALIZE wird nicht mehr ausgewertet. Verbindungsrechte bleiben nötig.
LEXMCP_ENABLE_DELETE=false
