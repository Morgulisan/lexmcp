# Set these outside the repository and webroot. No credentials belong here.
TODO_PUBLIC_URL=https://todo.mopoliti.de
# Optional overrides; defaults use the existing installation paths.
TODO_DATABASE_INCLUDE=/includes/api/sql.php
TODO_DATA_PATH=/data/todo.mopoliti.de
# Optional. Without this value a key is generated once in TODO_DATA_PATH.
TODO_ENCRYPTION_KEY=
# Absolute path to clamscan; uploads fail closed when missing or unhealthy.
TODO_MALWARE_SCANNER=/usr/bin/clamscan
